# Mirialis — variabili d'ambiente. SOLO NOMI: nessun valore reale in questo file.
# I segreti vivono in .env.local (git-ignored), nelle Environment Variables di Vercel
# o nelle credenziali di n8n. Mai nel codice, nei workflow esportati o nel frontend.

DATABASE_URL=            # Neon Postgres (connessione pooled)
AUTH_SECRET=             # firma cookie di sessione, min 32 caratteri (openssl rand -base64 48)
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (storage privato documenti)

OPENAI_API_KEY=
OPENAI_MODEL_DOCS=       # verificato: gpt-5.5 (documenti, timeline, RFQ)
OPENAI_MODEL_REPLIES=    # verificato: gpt-5.4-mini (risposte fornitori, prezzi, bozze)

SMARTLEAD_MODE=          # mock | test | live — eventi campagna (default mock)
MAILBOX_MODE=            # mock | test | live — risposte dalla dashboard (default mock)
ALLOW_LIVE_SEND=         # "true" richiesto perché live possa spedire
TEST_RECIPIENT_ALLOWLIST=  # indirizzi ammessi in modalità test, separati da virgola

N8N_SHARED_SECRET=            # firma HMAC con timestamp, in entrambe le direzioni
N8N_SEND_REPLY_WEBHOOK_URL=   # Workflow 2: invio risposta approvata dalla casella del cliente
N8N_CHECK_SENT_WEBHOOK_URL=   # Workflow 2: verifica "già inviata?" su esito ambiguo
N8N_NOTIFY_WEBHOOK_URL=       # Workflow 3: notifiche al cliente
