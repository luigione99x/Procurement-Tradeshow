# --- Database (Neon Postgres) ---
# DATABASE_URL: connessione pooled (per l'app in produzione/serverless)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: connessione diretta (usata da Prisma per le migrazioni)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# --- Autenticazione ---
# Stringa casuale lunga usata per firmare i cookie di sessione (JWT). Generare con: openssl rand -base64 32
AUTH_SECRET="cambia-questo-valore-con-una-stringa-casuale-lunga"

# --- Vercel Blob (archivio documenti) ---
# Generato automaticamente da Vercel quando si collega uno Storage Blob al progetto
BLOB_READ_WRITE_TOKEN=""

# --- OpenAI (compiti AI: qualificazione, capitolato, estrazione, piano, chat) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Serper (ricerca web allestitori) ---
SERPER_API_KEY=""

# --- Gmail (casella dedicata per invio/ricezione RFQ) ---
# Creare un progetto OAuth2 in Google Cloud Console (tipo "Desktop app" o "Web application"),
# abilitare la Gmail API, generare un refresh token con scope:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.modify
# Vedi README.md sezione "Configurare Gmail" per la procedura passo-passo.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_REDIRECT_URI="https://developers.google.com/oauthplayground"
GMAIL_ADDRESS=""

# --- Cron / job in background ---
# Segreto condiviso per autenticare le chiamate di Vercel Cron alle route /api/cron/*
CRON_SECRET="cambia-questo-valore-con-una-stringa-casuale"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
