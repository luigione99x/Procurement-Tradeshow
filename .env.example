# Mirialis — variabili d'ambiente. SOLO NOMI: nessun valore reale in questo file.
# I segreti vivono in .env.local (git-ignored), nelle Environment Variables di Vercel
# o nelle credenziali di n8n. Mai nel codice, nei workflow esportati o nel frontend.

# --- Database (Neon Postgres) ---
DATABASE_URL=            # connessione pooled (app serverless)
DIRECT_URL=              # connessione diretta (migrazioni Prisma)

# --- Autenticazione ---
AUTH_SECRET=             # openssl rand -base64 32

# --- Storage documenti (Vercel Blob, accesso privato) ---
BLOB_READ_WRITE_TOKEN=

# --- OpenAI (solo lato server) ---
OPENAI_API_KEY=
OPENAI_MODEL_DOCS=       # modello per documenti/PDF/timeline/RFQ (deve supportare Structured Outputs + input PDF)
OPENAI_MODEL_REPLIES=    # modello per classificazione risposte, estrazione prezzi, bozze
OPENAI_MODEL=            # legacy: usato dal codice esistente finché non migra ai due valori sopra

# --- Provider AI secondario (codice esistente; fallback automatico da disattivare, vedi docs/DECISIONI.md D7) ---
ANTHROPIC_API_KEY=
AI_PRIMARY_PROVIDER=
AI_FALLBACK_PROVIDER=

# --- Smartlead (raggiunto SOLO da n8n) ---
# La chiave Smartlead NON va qui: si crea come credenziale in n8n (HTTP Query Auth, parametro api_key).
SMARTLEAD_MODE=          # mock | test | live — campagne (default: mock)
MAILBOX_MODE=            # mock | test | live — risposte dalla dashboard (default: mock)

# --- Guard sugli invii reali ---
ALLOW_LIVE_SEND=         # deve essere "true" perché le modalità live possano spedire
TEST_RECIPIENT_ALLOWLIST=  # indirizzi di test ammessi in modalità test, separati da virgola

# --- n8n <-> backend ---
N8N_SHARED_SECRET=            # firma HMAC con timestamp, in entrambe le direzioni
N8N_SMARTLEAD_WEBHOOK_URL=    # workflow "Smartlead bridge" (campagne, lead, account, cronologia)
N8N_SEND_REPLY_WEBHOOK_URL=   # Workflow 2: invio risposta approvata nel thread Smartlead
N8N_CHECK_SENT_WEBHOOK_URL=   # Workflow 2: verifica "già inviata?" su esito ambiguo
N8N_NOTIFY_WEBHOOK_URL=       # Workflow 3: notifiche al cliente

# --- Codice esistente (in dismissione: invio/lettura Gmail diretti, vedi docs/DECISIONI.md D4) ---
SERPER_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
GMAIL_ADDRESS=
EMAIL_MODE=              # sandbox (default) | live
EMAIL_TEST_ALLOWLIST=
EMAIL_DAILY_LIMIT=

# --- Cron ---
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=

# --- Seed staff (solo npm run db:seed) ---
MIRALIS_ADMIN_EMAIL=
MIRALIS_ADMIN_NAME=
MIRALIS_ADMIN_PASSWORD=
