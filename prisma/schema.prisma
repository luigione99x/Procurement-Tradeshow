// Schema del database per la gestione di pratiche fieristiche (procurement stand).
// Ogni pratica (Pratica) collega brief, documenti, fornitori, RFQ, email, offerte,
// decisioni, piano di esecuzione e log — tutto scoped per azienda (multi-tenant).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Tenancy & auth ----------
// Miralis opera come agenzia: UNA company di tipo MIRALIS (lo staff interno,
// vede tutti i clienti/progetti) e N company di tipo CLIENT (un tenant per
// azienda espositrice, isolamento dati invariato rispetto al prototipo originale).

enum CompanyType {
  MIRALIS
  CLIENT
}

model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType @default(CLIENT)
  lingua    String      @default("it") // "it" | "en", lingua preferita del tenant cliente
  valuta    String      @default("EUR")
  createdAt DateTime    @default(now())

  users             User[]
  pratiche          Pratica[]
  integrationConfig IntegrationConfig[]
  gmailSyncState    GmailSyncState?
}

enum UserRole {
  MIRALIS_ADMIN // staff Miralis: vede tutti i clienti/progetti, gestisce database fornitori, fee, utenti
  MIRALIS_OPERATOR // staff Miralis: lavora solo sui progetti assegnati, nessuna operazione distruttiva/impostazioni globali
  CLIENT // referente dell'azienda espositrice, vede solo i progetti della propria organizzazione
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CLIENT)
  lingua       String   @default("it")
  createdAt    DateTime @default(now())

  praticheCreate    Pratica[]            @relation("PraticaCreatedBy")
  documentiCaricati Documento[]
  decisioniPrese    Decisione[]
  auditLogs         AuditLog[]
  teamMemberships   PraticaTeamMember[]
  supplierImportBatches SupplierImportBatch[]
  suppliersCreated  Supplier[]           @relation("SupplierCreatedBy")
  fornitoriRivelati Fornitore[]          @relation("FornitoreRevealedBy")
  baselineApprovate SavingsBaseline[]    @relation("BaselineApprovedBy")
  baselineCreate    SavingsBaseline[]    @relation("BaselineCreatedBy")

  @@index([companyId, role])
}

// Assegnazione di un utente (staff Miralis o referente cliente) a un progetto.
// Un MIRALIS_OPERATOR vede/lavora solo sui progetti dove ha una riga qui.
enum ProjectMemberRole {
  MIRALIS_LEAD
  MIRALIS_OPERATOR
  CLIENT_CONTACT
}

model PraticaTeamMember {
  id        String            @id @default(cuid())
  praticaId String
  pratica   Pratica           @relation(fields: [praticaId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  role      ProjectMemberRole
  createdAt DateTime          @default(now())

  @@unique([praticaId, userId])
  @@index([userId])
}

// ---------- Pratica (fiera) ----------

enum PraticaStatus {
  QUALIFICAZIONE // chat AI in corso, capitolato non ancora approvato
  RICERCA_FORNITORI // capitolato approvato, ricerca in corso/completata
  RFQ_INVIATE // RFQ inviate, in attesa risposte
  CONFRONTO_OFFERTE // offerte ricevute, confronto in corso
  FORNITORE_SCELTO // decisione presa, piano di esecuzione attivo
  COMPLETATA
  ARCHIVIATA
}

enum QualificazioneStato {
  IN_CORSO // conversazione con l'AI ancora in corso
  PRONTA_PER_REVISIONE // l'AI ha prodotto un'estrazione, in attesa di conferma utente
  CONFERMATA // utente ha confermato: si può generare il capitolato
}

enum StrategiaFornitori {
  DA_DECIDERE
  ALLESTITORE_UNICO // un fornitore chiavi in mano gestisce tutto
  MULTI_FORNITORE // l'utente gestisce più fornitori per categoria/attività
}

// Fase spec-aligned del progetto (Sezione 11 del brief Miralis): più granulare dello
// storico PraticaStatus, che resta invariato per non rompere le pagine/route esistenti.
// "phase" è il campo su cui si innestano le funzionalità nuove (roadmap, document room).
enum ProjectPhase {
  DRAFT
  INTAKE
  BRIEF_REVIEW
  SUPPLIER_SOURCING
  RFQ_PREPARATION
  RFQ_ACTIVE
  QUOTE_COLLECTION
  QUOTE_COMPARISON
  NEGOTIATION
  SUPPLIER_SELECTION
  EXECUTION
  BUILD_UP
  LIVE_EVENT
  DISMANTLING
  COMPLETED
  ARCHIVED
}

model Pratica {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  status    PraticaStatus @default(QUALIFICAZIONE)
  phase     ProjectPhase  @default(DRAFT)
  isDemo    Boolean       @default(false)
  lingua    String        @default("it")
  codiceProgetto String?  @unique // es. MIR-2027-0024, usato per identificare i thread email

  // fee/baseline di default per il progetto (sez. 3 del brief): percentuale e cap
  // modificabili per progetto, MAI applicati automaticamente al budget dichiarato.
  feePercentualeConcordata Decimal  @default(30) @db.Decimal(5, 2)
  feeCapImporto            Decimal? @db.Decimal(12, 2)

  duplicatedFromId String?
  duplicatedFrom   Pratica?  @relation("PraticaDuplicata", fields: [duplicatedFromId], references: [id])
  duplicati        Pratica[] @relation("PraticaDuplicata")

  nome                     String
  fieraNome                String
  citta                    String?
  padiglione               String?
  dataInizioFiera          DateTime?
  dataFineFiera            DateTime?
  dimensioneMq             Float?
  posizioneStand           String?
  budgetTotalePartecip     Decimal?  @db.Decimal(12, 2)
  budgetStand              Decimal?  @db.Decimal(12, 2)
  obiettivi                String?
  prodottiEsposti          String?
  scadenzaSceltaFornitore  DateTime?
  referenteAziendaleNome   String?
  referenteAziendaleEmail  String?
  fornitoreStoricoNome     String?
  fornitoreStoricoContatto String?

  // campi strutturati raccolti dalla chat di qualificazione (chiavi dinamiche, decise dall'AI in base alla conversazione)
  qualificazione Json?
  qualificazioneStato QualificazioneStato @default(IN_CORSO)
  // estrazione proposta dall'AI in attesa di conferma dell'utente: [{ chiave, etichetta, valore }]
  qualificazioneEstrazione Json?

  strategiaFornitori StrategiaFornitori @default(DA_DECIDERE)
  // se MULTI_FORNITORE: categorie di fornitori individuate dall'AI dal capitolato: [{ categoria, queryRicerca, motivazione }]
  categorieFornitori Json?

  createdById String
  createdBy   User     @relation("PraticaCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documenti          Documento[]
  chatMessages       ChatMessage[]
  capitolatoVersions CapitolatoVersion[]
  fornitori          Fornitore[]
  ricercheLog        FornitoreRicercaLog[]
  rfqCampaigns       RFQCampaign[]
  emailThreads       EmailThread[]
  offerte            Offerta[]
  decisione          Decisione?
  pianoAttivita      PianoAttivita[]
  rischi             Rischio[]
  auditLogs          AuditLog[]
  noteManuali        NotaManuale[]
  teamMembers        PraticaTeamMember[]
  savingsBaselines   SavingsBaseline[]

  @@index([companyId, status])
  @@index([phase])
}

// ---------- Documenti ----------

enum DocumentoTipo {
  PLANIMETRIA
  MANUALE_ESPOSITORE
  CHECKLIST
  IMMAGINE_RIFERIMENTO
  PREVENTIVO_PRECEDENTE
  MATERIALE_BRAND
  CONTRATTO
  OFFERTA_PDF
  ALLEGATO_EMAIL
  RICEVUTA_NOTA
  ALTRO
}

model Documento {
  id         String        @id @default(cuid())
  praticaId  String
  pratica    Pratica       @relation(fields: [praticaId], references: [id])
  tipo       DocumentoTipo
  fileName   String
  blobUrl    String
  mimeType   String?
  size       Int?
  extractedText String? // testo estratto (per PDF, quando disponibile) usato per citazioni

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([praticaId, tipo])
}

// ---------- Chat AI (qualificazione + assistente di pratica) ----------

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatContext {
  QUALIFICAZIONE
  ASSISTENTE
}

model ChatMessage {
  id        String      @id @default(cuid())
  praticaId String
  pratica   Pratica     @relation(fields: [praticaId], references: [id])
  context   ChatContext @default(ASSISTENTE)
  role      ChatRole
  content   String
  citazioni Json? // [{tipo: 'email'|'documento', ref, snippet}]
  createdAt DateTime    @default(now())

  @@index([praticaId, context, createdAt])
}

// ---------- Capitolato ----------

enum CapitolatoStatus {
  BOZZA
  IN_ATTESA_APPROVAZIONE
  APPROVATO
  SUPERATO // sostituito da versione successiva
}

model CapitolatoVersion {
  id            String           @id @default(cuid())
  praticaId     String
  pratica       Pratica          @relation(fields: [praticaId], references: [id])
  versionNumber Int
  status        CapitolatoStatus @default(BOZZA)
  contentJson   Json // requisiti obbligatori, desiderabili, servizi da includere/quotare separatamente, vincoli, budget, scadenze
  contentMarkdown String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())

  rfqCampaigns RFQCampaign[]

  @@unique([praticaId, versionNumber])
}

// ---------- Database fornitori proprietario Miralis (globale, non scoped per cliente) ----------
// Asset proprietario Miralis (Sezione 6/8 del brief): MAI esposto integralmente al cliente.
// L'accesso a questo modello è filtrato lato server solo per ruoli MIRALIS_ADMIN/MIRALIS_OPERATOR
// (vedi src/lib/authz.ts) — nessuna route cliente deve mai interrogare `prisma.supplier` direttamente.

enum SupplierSourceType {
  MIRALIS_DATABASE // importato dal database proprietario Miralis (~200 allestitori)
  CLIENT_PROVIDED // indicato direttamente dal cliente: visibile da subito
  MANUALLY_ADDED // aggiunto manualmente dallo staff Miralis
  EXTERNAL_RESEARCH // trovato con ricerca web (Serper) per un progetto specifico
  INBOUND_SUPPLIER // fornitore che si è proposto spontaneamente
}

enum SupplierCategory {
  GENERAL_CONTRACTOR
  STAND_BUILDER
  DESIGN
  GRAPHICS
  LIGHTING
  ELECTRICAL
  AV
  FURNITURE
  LOGISTICS
  CATERING
  INTERNET
  RIGGING
  CLEANING
  SAFETY
  WASTE_DISPOSAL
}

enum SupplierVerificationStatus {
  NON_VERIFICATO
  VERIFICATO
  SEGNALATO // rating negativo/problemi -> richiede attenzione prima di riusarlo
}

enum SupplierContactability {
  SCONOSCIUTA
  CONTATTABILE
  BOUNCING
  OPT_OUT
  BLACKLIST
}

model Supplier {
  id                 String                     @id @default(cuid())
  publicId           String                     @unique @default(cuid()) // id non enumerabile per URL/signed link
  ragioneSociale      String
  nomeCommerciale     String?
  paese               String                     @default("IT")
  regione             String?
  citta               String?
  provincia           String?
  indirizzo           String?
  sito                String?
  dominioNormalizzato String?
  emailGenerale       String?
  emailNormalizzata   String?
  telefono            String?
  lingue              String[]
  categorie           SupplierCategory[]
  fiereConosciute     String[]
  venueConosciute     String[]
  areeServite         String[]
  dimensioniStandGestibili String?
  servizi             String[]
  certificazioni      String[]
  fasciaPrezzo        String?
  rating              Float?
  puntualita          Float?
  qualita             Float?
  capacitaRisposta    Float?
  progettiPrecedenti  String?
  noteInterne         String? // MAI esposte al cliente

  sourceType          SupplierSourceType         @default(MANUALLY_ADDED)
  isProprietary       Boolean                    @default(false) // true per tutto ciò che entra da MIRALIS_DATABASE
  verificationStatus  SupplierVerificationStatus @default(NON_VERIFICATO)
  contactability      SupplierContactability     @default(SCONOSCIUTA)

  importBatchId       String?
  importBatch         SupplierImportBatch?       @relation(fields: [importBatchId], references: [id])
  createdByUserId     String?
  createdBy           User?                      @relation("SupplierCreatedBy", fields: [createdByUserId], references: [id])

  ultimaInterazioneAt DateTime?
  deletedAt           DateTime? // soft delete: mai cancellazione fisica di un asset proprietario

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  contatti            SupplierContact[]
  progetti            Fornitore[]
  suppressioni        SupplierSuppression[]

  @@index([dominioNormalizzato])
  @@index([emailNormalizzata])
  @@index([sourceType, isProprietary])
  @@index([ragioneSociale])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  nome       String?
  ruolo      String?
  email      String?
  telefono   String?
  lingua     String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// Un batch = un'importazione file (Sezione 7): report immutabile per audit.
model SupplierImportBatch {
  id               String             @id @default(cuid())
  fileName         String
  fileFormat       String // csv | xlsx | xls | tsv
  columnMapping    Json // mapping colonne sorgente -> campi target confermato dall'operatore
  totalRows        Int                @default(0)
  imported         Int                @default(0)
  updated          Int                @default(0)
  duplicates       Int                @default(0)
  discarded        Int                @default(0)
  missingEmail     Int                @default(0)
  invalidEmail     Int                @default(0)
  needsReview      Int                @default(0)
  status           ImportBatchStatus  @default(PROCESSING)
  reportJson       Json?
  importedByUserId String
  importedBy       User               @relation(fields: [importedByUserId], references: [id])
  createdAt        DateTime           @default(now())

  suppliers        Supplier[]
}

enum SuppressionReason {
  OPT_OUT
  BOUNCE
  BLACKLIST
  MANUALE
}

// Suppression list globale (Sezione 16): un fornitore soppresso non riceve più invii,
// indipendentemente dal progetto (a meno che la soppressione sia scoped a un solo progetto).
model SupplierSuppression {
  id              String            @id @default(cuid())
  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  reason          SuppressionReason
  note            String?
  praticaId       String? // valorizzato solo se la soppressione riguarda un singolo progetto (es. rifiuto per quella gara)
  createdByUserId String?
  createdAt       DateTime          @default(now())

  @@index([supplierId])
}

// ---------- Fornitori nel progetto (project_suppliers): associazione + stato + visibilità cliente ----------

enum FornitoreStato {
  CANDIDATO
  SHORTLIST
  SCARTATO
  RFQ_INVIATA
  // stati granulari allineati alla Sezione 9 del brief Miralis, usati dalle funzionalità nuove
  APPROVED_FOR_CONTACT
  CONTACTED
  AWAITING_REPLY
  AUTOMATIC_REPLY
  BOUNCED
  REPLIED
  CLARIFICATION
  QUOTE_RECEIVED
  FINALIST
  NEGOTIATING
  REJECTED
  SELECTED
  OPTED_OUT
  NO_RESPONSE
}

enum FornitoreFonte {
  RICERCA_SERPER
  MANUALE
  STORICO_CLIENTE
}

// Visibilità del fornitore per il cliente (Sezione 6): HIDDEN finché non arriva una risposta
// umana valida (o approvazione Miralis), REVEALED da quel momento. Applicata SEMPRE server-side.
enum ClientVisibility {
  HIDDEN
  REVEALED
}

model Fornitore {
  id             String         @id @default(cuid())
  praticaId      String
  pratica        Pratica        @relation(fields: [praticaId], references: [id])
  nome           String
  categoria      String? // categoria/attività per cui è stato individuato (es. "Elettricista", "Allestitore generale"), usata in strategia MULTI_FORNITORE
  sito           String?
  areaOperativa  String?
  serviziDichiarati String?
  esempiProgetti String?
  email          String?
  emailVerificata Boolean       @default(false)
  emailFonteUrl  String? // URL esatto dove è stata trovata l'email
  ragionePertinenza String?
  dubbi          String? // es. "sito non accessibile", "email non trovata"
  sitoAccessibile Boolean?
  stato          FornitoreStato @default(CANDIDATO)
  fonte          FornitoreFonte @default(RICERCA_SERPER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // --- collegamento al database proprietario e protezione identità (Sezione 6) ---
  supplierId               String?
  supplier                 Supplier?          @relation(fields: [supplierId], references: [id])
  sourceType                SupplierSourceType @default(MANUALLY_ADDED)
  isProprietary             Boolean            @default(false)
  clientVisibility          ClientVisibility   @default(REVEALED) // HIDDEN impostato alla creazione se sourceType = MIRALIS_DATABASE
  compatibilityScore        Float?
  motivoSelezione           String?
  contactedAt               DateTime?
  lastContactAt             DateTime?
  firstValidReplyAt         DateTime?
  replyConfidence           Float?
  requiresVisibilityReview  Boolean            @default(false)
  revealedAt                DateTime?
  revealedByUserId          String?
  revealedBy                User?              @relation("FornitoreRevealedBy", fields: [revealedByUserId], references: [id])
  revealReason               String?

  rfqInvii     RFQInvio[]
  emailThreads EmailThread[]
  offerte      Offerta[]

  @@index([praticaId, stato])
  @@index([praticaId, clientVisibility])
  @@index([supplierId])
}

model FornitoreRicercaLog {
  id        String   @id @default(cuid())
  praticaId String
  pratica   Pratica  @relation(fields: [praticaId], references: [id])
  query     String
  fonte     String   @default("serper")
  risultatiJson Json
  createdAt DateTime @default(now())

  @@index([praticaId])
}

// ---------- RFQ ----------

enum RFQCampaignStatus {
  BOZZA
  IN_ATTESA_APPROVAZIONE
  APPROVATA
  INVIO_IN_CORSO
  INVIATA
}

model RFQCampaign {
  id                  String            @id @default(cuid())
  praticaId           String
  pratica             Pratica           @relation(fields: [praticaId], references: [id])
  capitolatoVersionId String
  capitolatoVersion   CapitolatoVersion @relation(fields: [capitolatoVersionId], references: [id])
  status              RFQCampaignStatus @default(BOZZA)
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime          @default(now())

  invii RFQInvio[]

  @@index([praticaId])
}

enum RFQInvioStatus {
  BOZZA
  PRONTO
  INVIO_IN_CORSO
  INVIATO
  FALLITO
}

model RFQInvio {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    RFQCampaign    @relation(fields: [campaignId], references: [id])
  fornitoreId String
  fornitore   Fornitore      @relation(fields: [fornitoreId], references: [id])
  toEmail     String
  subject     String
  bodyText    String
  allegatiIds String[] // Documento ids allegati
  status      RFQInvioStatus @default(BOZZA)
  dedupeKey   String         @unique // campaignId+fornitoreId+capitolatoVersionId per evitare doppi invii
  gmailMessageId String?
  gmailThreadId  String?
  sentAt         DateTime?
  errorMessage   String?
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
}

// ---------- Comunicazioni (email) ----------

model EmailThread {
  id            String     @id @default(cuid())
  praticaId     String
  pratica       Pratica    @relation(fields: [praticaId], references: [id])
  fornitoreId   String?
  fornitore     Fornitore? @relation(fields: [fornitoreId], references: [id])
  gmailThreadId String     @unique
  subject       String?
  lastMessageAt DateTime?
  createdAt     DateTime   @default(now())

  messages EmailMessage[]

  @@index([praticaId])
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailClassification {
  NON_CLASSIFICATA
  DISPONIBILE
  NON_DISPONIBILE
  CHIEDE_CHIARIMENTI
  OFFERTA_RICEVUTA
  DA_VERIFICARE
  ALTRO
  // estensione Sezione 17: categorie granulari, in particolare quelle che
  // NON devono mai attivare la rivelazione del fornitore (vedi supplierVisibility.ts)
  OFFERTA_REVISIONATA
  DOCUMENTO_RICEVUTO
  RISPOSTA_NEGOZIAZIONE
  FORNITORE_SI_RITIRA
  RISPOSTA_AUTOMATICA
  FUORI_SEDE
  BOUNCE
  NON_PERTINENTE
}

model EmailMessage {
  id             String               @id @default(cuid())
  threadId       String
  thread         EmailThread          @relation(fields: [threadId], references: [id])
  gmailMessageId String               @unique
  direction      EmailDirection
  fromAddress    String?
  toAddress      String?
  subject        String?
  bodyText       String?
  bodyHtml       String?
  receivedAt     DateTime?
  classification EmailClassification  @default(NON_CLASSIFICATA)
  estrazioneJson Json? // dati estratti dall'AI con riferimenti di fonte
  createdAt      DateTime             @default(now())

  allegati EmailAttachment[]
  offerte  Offerta[]

  @@index([threadId])
}

model EmailAttachment {
  id        String       @id @default(cuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id])
  fileName  String
  blobUrl   String
  mimeType  String?
  size      Int?
}

// ---------- Offerte ----------

enum OffertaStato {
  DA_VERIFICARE
  CONFERMATA
  SCARTATA
}

model Offerta {
  id            String       @id @default(cuid())
  praticaId     String
  pratica       Pratica      @relation(fields: [praticaId], references: [id])
  fornitoreId   String
  fornitore     Fornitore    @relation(fields: [fornitoreId], references: [id])
  emailMessageId String?
  emailMessage  EmailMessage? @relation(fields: [emailMessageId], references: [id])
  documentoId   String? // eventuale PDF offerta

  versionNumber Int      @default(1)
  stato         OffertaStato @default(DA_VERIFICARE)

  prezzo             Decimal? @db.Decimal(12, 2)
  valuta             String?  @default("EUR")
  ivaInclusa         Boolean?
  progetto           String?
  produzione         String?
  grafiche           String?
  arredi             String?
  trasporto          String?
  montaggio          String?
  smontaggio         String?
  serviziTecnici     String?
  praticheFieristiche String?
  condizioniPagamento String?
  tempiConsegna      String?
  validitaOfferta    DateTime?
  riutilizzabilita   String?
  esclusioni         String?
  rischiNote         String?

  fieldSources FieldSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisioniScelte Decisione[] @relation("OffertaScelta")

  @@index([praticaId, fornitoreId])
}

// citazione della fonte per ogni campo estratto (email, pagina, documento+pagina)
model FieldSource {
  id         String   @id @default(cuid())
  offertaId  String
  offerta    Offerta  @relation(fields: [offertaId], references: [id])
  fieldName  String
  sourceType String // "email" | "documento"
  sourceRef  String // id messaggio email o id documento
  pageNumber Int?
  snippet    String?
  createdAt  DateTime @default(now())

  @@index([offertaId, fieldName])
}

// ---------- Baseline del risparmio (Sezione 3) ----------
// La baseline NON è mai il budget del cliente: deve provenire da un preventivo/fonte
// documentata, essere approvata e bloccata. Versionata: una modifica successiva crea
// una nuova versione con motivazione, la precedente passa a SUPERSEDED (mai cancellata).

enum BaselineType {
  PREVENTIVO_INCUMBENT
  PREVENTIVO_PRECEDENTE_COMPARABILE
  PRIMA_MIGLIORE_OFFERTA_COMPARABILE
  CONCORDATA_MANUALMENTE
}

enum BaselineStatus {
  DRAFT
  APPROVED
  LOCKED
  SUPERSEDED
}

model SavingsBaseline {
  id                String         @id @default(cuid())
  praticaId         String
  pratica           Pratica        @relation(fields: [praticaId], references: [id])
  versionNumber     Int
  type              BaselineType
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("EUR")
  documentoId       String? // fonte: documento
  offertaId         String? // fonte: preventivo/offerta
  note              String?
  status            BaselineStatus @default(DRAFT)
  supersedeReason   String? // obbligatorio quando si crea una nuova versione che sostituisce questa
  approvedByUserId  String?
  approvedBy        User?          @relation("BaselineApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  createdByUserId   String
  createdBy         User           @relation("BaselineCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime       @default(now())

  decisioni Decisione[]

  @@unique([praticaId, versionNumber])
  @@index([praticaId, status])
}

// ---------- Decisione ----------

model Decisione {
  id          String   @id @default(cuid())
  praticaId   String   @unique
  pratica     Pratica  @relation(fields: [praticaId], references: [id])
  offertaSceltaId String
  offertaScelta   Offerta @relation("OffertaScelta", fields: [offertaSceltaId], references: [id])

  contrattoDocumentoId String?
  prezzoFinale          Decimal?  @db.Decimal(12, 2)
  referenteFornitore    String?
  dateConcordate        Json?
  note                  String?

  // Baseline versionata usata (se presente) per calcolare prezzoInizialeRiferimento
  // (Sezione 3): tracciabilità di quale versione della baseline ha fondato la fee.
  baselineId String?
  baseline   SavingsBaseline? @relation(fields: [baselineId], references: [id])

  prezzoInizialeRiferimento Decimal? @db.Decimal(12, 2)
  provaPrezzoInizialeDocId  String? // documento/email che prova il prezzo iniziale
  provaPrezzoFinaleDocId    String?
  risparmioVerificabile     Boolean  @default(false)
  risparmioCalcolato        Decimal? @db.Decimal(12, 2)
  feeAccessoAnnua           Decimal  @default(500) @db.Decimal(12, 2)
  feeSuccessPercentuale     Decimal  @default(30) @db.Decimal(5, 2)
  feeSuccessCalcolata       Decimal  @default(0) @db.Decimal(12, 2)

  decisoDaId String
  decisoDa   User     @relation(fields: [decisoDaId], references: [id])
  decisoAt   DateTime @default(now())
}

// ---------- Piano di esecuzione ----------

enum TaskStato {
  RICHIESTO
  PROMESSO
  RICEVUTO
  APPROVATO
  COMPLETATO
  BLOCCATO
}

enum ResponsabileTipo {
  CLIENTE
  ALLESTITORE
  ENTE_FIERA
  ALTRO_FORNITORE
  NOI
  DA_CONFERMARE
}

model PianoAttivita {
  id          String           @id @default(cuid())
  praticaId   String
  pratica     Pratica          @relation(fields: [praticaId], references: [id])
  titolo      String
  descrizione String?
  responsabileTipo ResponsabileTipo @default(DA_CONFERMARE)
  responsabileNome String?
  stato       TaskStato        @default(RICHIESTO)
  scadenza    DateTime?
  dataPromessaOriginale DateTime?
  dipendenzeIds String[]
  fonteType   String? // "email" | "documento" | "manuale"
  fonteRef    String?
  storico     Json? // changelog delle modifiche di stato/data con fonte e timestamp
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rischi Rischio[]

  @@index([praticaId, stato])
}

enum RischioSeverita {
  BASSA
  MEDIA
  ALTA
}

enum RischioStato {
  APERTO
  RISOLTO
}

model Rischio {
  id           String          @id @default(cuid())
  praticaId    String
  pratica      Pratica         @relation(fields: [praticaId], references: [id])
  taskId       String?
  task         PianoAttivita?  @relation(fields: [taskId], references: [id])
  fornitoreId  String?
  descrizione  String
  severita     RischioSeverita @default(MEDIA)
  stato        RischioStato    @default(APERTO)
  fonteRef     String?
  azioneProposta String?
  bozzaFollowUp  String?
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  @@index([praticaId, stato])
}

// note manuali: telefonate, azioni su portali fiera, non tracciabili via email
model NotaManuale {
  id          String   @id @default(cuid())
  praticaId   String
  pratica     Pratica  @relation(fields: [praticaId], references: [id])
  tipo        String // "telefonata" | "portale" | "altro"
  descrizione String
  allegatoDocumentoId String?
  data        DateTime @default(now())
  registratoDaNome String?
  createdAt   DateTime @default(now())
}

// ---------- Log / audit ----------

enum AuditAudience {
  INTERNAL // visibile solo a staff Miralis
  CLIENT_SAFE // visibile anche al cliente: NON deve mai contenere nomi/dettagli di fornitori nascosti
}

model AuditLog {
  id         String   @id @default(cuid())
  praticaId  String
  pratica    Pratica  @relation(fields: [praticaId], references: [id])
  actorType  String // "sistema" | "utente"
  actorUserId String?
  actorUser  User?    @relation(fields: [actorUserId], references: [id])
  tipo       String
  descrizione String
  audience   AuditAudience @default(INTERNAL)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([praticaId, createdAt])
  @@index([praticaId, audience, createdAt])
}

// ---------- Integrazioni ----------

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  SERPER
  GMAIL
}

model IntegrationConfig {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  provider      IntegrationProvider
  connected     Boolean             @default(false)
  metadata      Json? // dati non sensibili (es. email Gmail collegata)
  lastCheckedAt DateTime?
  lastError     String?

  @@unique([companyId, provider])
}

model GmailSyncState {
  id            String   @id @default(cuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id])
  historyId     String?
  lastSyncAt    DateTime?
  lastError     String?
}

// ultimo accesso di un utente a una pratica, per mostrare "cosa è successo dall'ultimo accesso"
model PraticaAccess {
  id           String   @id @default(cuid())
  praticaId    String
  userId       String
  lastViewedAt DateTime @default(now())

  @@unique([praticaId, userId])
}

// idempotenza dei job in background (evita doppi invii/elaborazioni dopo un riavvio)
enum JobStatus {
  IN_CORSO
  COMPLETATO
  FALLITO
}

model BackgroundJobRun {
  id         String    @id @default(cuid())
  jobType    String
  dedupeKey  String    @unique
  status     JobStatus @default(IN_CORSO)
  resultJson Json?
  errorMessage String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
